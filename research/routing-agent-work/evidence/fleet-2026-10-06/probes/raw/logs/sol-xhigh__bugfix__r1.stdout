{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom itertools import permutations\nfrom ledger.money import format_cents, parse_amount\nfrom ledger.parse import parse_date, parse_record, parse_ledger\nfrom ledger.report import line_total, totals_by_item, top_items, summary_line\n\nfor cents, expected in [\n    (-123456789, '-\"'$1,234,567.89'\"'), (-310, '-\"'$3.10'\"'),\n    (-105, '-\"'$1.05'\"'), (-100, '-\"'$1.00'\"'), (-5, '-\"'$0.05'\"'),\n    (-1, '-\"'$0.01'\"'), (0, '\"'$0.00'\"'), (5, '\"'$0.05'\"'),\n    (100, '\"'$1.00'\"'), (123456, '\"'$1,234.56'\"'),\n]:\n    assert format_cents(cents) == expected\nfor cents in range(-10000, 10001):\n    assert parse_amount(format_cents(cents)) == cents\nfor cents in [10**100 + 5, -(10**100 + 5)]:\n    assert parse_amount(format_cents(cents)) == cents\nfor amount, expected in [\n    ('\"'$1,234.56'\"', 123456), ('-\"'$3.10'\"', -310), ('12', 1200),\n    ('0.5', 50), ('0.05', 5), ('  -\"'$0.05  '\"', -5), ('0', 0),\n]:\n    assert parse_amount(amount) == expected\nfor text, expected in [\n    ('2026-10-06', (2026, 10, 6)),\n    (' 2024-02-29 ', (2024, 2, 29)),\n    ('2000-12-01', (2000, 12, 1)),\n]:\n    assert parse_date(text) == expected\nassert parse_record(' 2026-10-06 | WiDgEt | -3 | \"'$4.50 '\"') == {\n    'date': (2026, 10, 6), 'item': 'widget', 'qty': -3, 'unit_cents': 450,\n}\ntext = '\\\\n  # comment\\\\n \\\\t\\\\n2026-10-06 | Refund | 2 | -\"'$0.05'\"\\\\r\\\\n'\nrecords = parse_ledger(text)\nassert records == [{\n    'date': (2026, 10, 6), 'item': 'refund', 'qty': 2, 'unit_cents': -5,\n}]\nassert line_total(records[0]) == -10\nassert summary_line(records) == 'refund=-\"'$0.10'\"'\nassert parse_ledger('\\\\n \\\\t\\\\n # comment\\\\n') == []\n\nrecords = [\n    {'item': 'zeta', 'qty': 2, 'unit_cents': -50},\n    {'item': 'beta', 'qty': 3, 'unit_cents': 50},\n    {'item': 'gamma', 'qty': 0, 'unit_cents': 999},\n    {'item': 'alpha', 'qty': -1, 'unit_cents': 100},\n    {'item': 'beta', 'qty': 1, 'unit_cents': 50},\n    {'item': 'alpha', 'qty': 3, 'unit_cents': 100},\n]\nexpected = [('alpha', 200), ('beta', 200), ('gamma', 0), ('zeta', -100)]\nassert totals_by_item(iter(records)) == dict(expected)\noriginal = [record.copy() for record in records]\nfor ordering in permutations(records):\n    for n in range(6):\n        assert top_items(iter(ordering), n) == expected[:n]\nassert records == original\nassert summary_line(iter(records)) == 'alpha=\"'$2.00; beta=$2.00; gamma=$0.00'\"'\nassert summary_line(records, 10) == 'alpha=\"'$2.00; beta=$2.00; gamma=$0.00; zeta=-$1.00'\"'\nassert summary_line(records, 0) == ''\nassert top_items([], 3) == []\nassert totals_by_item([]) == {}\nassert summary_line([]) == ''\nprint('PASS: documented examples, negative amounts, date order, comments, totals, ties, generators, and empty inputs')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom itertools import permutations\nfrom ledger.money import format_cents, parse_amount\nfrom ledger.parse import parse_date, parse_record, parse_ledger\nfrom ledger.report import line_total, totals_by_item, top_items, summary_line\n\nfor cents, expected in [\n    (-123456789, '-\"'$1,234,567.89'\"'), (-310, '-\"'$3.10'\"'),\n    (-105, '-\"'$1.05'\"'), (-100, '-\"'$1.00'\"'), (-5, '-\"'$0.05'\"'),\n    (-1, '-\"'$0.01'\"'), (0, '\"'$0.00'\"'), (5, '\"'$0.05'\"'),\n    (100, '\"'$1.00'\"'), (123456, '\"'$1,234.56'\"'),\n]:\n    assert format_cents(cents) == expected\nfor cents in range(-10000, 10001):\n    assert parse_amount(format_cents(cents)) == cents\nfor cents in [10**100 + 5, -(10**100 + 5)]:\n    assert parse_amount(format_cents(cents)) == cents\nfor amount, expected in [\n    ('\"'$1,234.56'\"', 123456), ('-\"'$3.10'\"', -310), ('12', 1200),\n    ('0.5', 50), ('0.05', 5), ('  -\"'$0.05  '\"', -5), ('0', 0),\n]:\n    assert parse_amount(amount) == expected\nfor text, expected in [\n    ('2026-10-06', (2026, 10, 6)),\n    (' 2024-02-29 ', (2024, 2, 29)),\n    ('2000-12-01', (2000, 12, 1)),\n]:\n    assert parse_date(text) == expected\nassert parse_record(' 2026-10-06 | WiDgEt | -3 | \"'$4.50 '\"') == {\n    'date': (2026, 10, 6), 'item': 'widget', 'qty': -3, 'unit_cents': 450,\n}\ntext = '\\\\n  # comment\\\\n \\\\t\\\\n2026-10-06 | Refund | 2 | -\"'$0.05'\"\\\\r\\\\n'\nrecords = parse_ledger(text)\nassert records == [{\n    'date': (2026, 10, 6), 'item': 'refund', 'qty': 2, 'unit_cents': -5,\n}]\nassert line_total(records[0]) == -10\nassert summary_line(records) == 'refund=-\"'$0.10'\"'\nassert parse_ledger('\\\\n \\\\t\\\\n # comment\\\\n') == []\n\nrecords = [\n    {'item': 'zeta', 'qty': 2, 'unit_cents': -50},\n    {'item': 'beta', 'qty': 3, 'unit_cents': 50},\n    {'item': 'gamma', 'qty': 0, 'unit_cents': 999},\n    {'item': 'alpha', 'qty': -1, 'unit_cents': 100},\n    {'item': 'beta', 'qty': 1, 'unit_cents': 50},\n    {'item': 'alpha', 'qty': 3, 'unit_cents': 100},\n]\nexpected = [('alpha', 200), ('beta', 200), ('gamma', 0), ('zeta', -100)]\nassert totals_by_item(iter(records)) == dict(expected)\noriginal = [record.copy() for record in records]\nfor ordering in permutations(records):\n    for n in range(6):\n        assert top_items(iter(ordering), n) == expected[:n]\nassert records == original\nassert summary_line(iter(records)) == 'alpha=\"'$2.00; beta=$2.00; gamma=$0.00'\"'\nassert summary_line(records, 10) == 'alpha=\"'$2.00; beta=$2.00; gamma=$0.00; zeta=-$1.00'\"'\nassert summary_line(records, 0) == ''\nassert top_items([], 3) == []\nassert totals_by_item([]) == {}\nassert summary_line([]) == ''\nprint('PASS: documented examples, negative amounts, date order, comments, totals, ties, generators, and empty inputs')\nPY\"","aggregated_output":"PASS: documented examples, negative amounts, date order, comments, totals, ties, generators, and empty inputs\n","exit_code":0,"status":"completed"}}
