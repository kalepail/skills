t(frac)\n    return -cents if neg else cents\n\n\ndef format_cents(cents):\n    \"\"\"Format integer cents as '$1,234.56'. Negative values look like '-$0.05'.\"\"\"\n    sign = \"-\" if cents < 0 else \"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/claude-501/-Users-kalepail-Desktop-kalepail-skills/fd5aae97-76bc-4bb3-8597-af0fa91bb3f0/scratchpad/probe-runs/muse-xhigh__bugfix__r1__1791296736/work/ledger/money.py","text":"\"\"\"Money helpers. All amounts are integer cents.\"\"\"\n\n\ndef parse_amount(text):\n    \"\"\"Parse '$1,234.56', '-$3.10', '12' or '0.5' into integer cents.\"\"\"\n    s = text.strip()\n    neg = s.startswith(\"-\")\n    s = s.lstrip(\"-\").lstrip(\"$\").replace(\",\", \"\")\n    if \".\" in s:\n        whole, frac = s.split(\".\")\n        frac = (frac + \"00\")[:2]\n    else:\n        whole, frac = s, \"00\"\n    cents = int(whole or \"0\") * 100 + int(frac)\n    return -cents if neg else cents\n\n\ndef format_cents(cents):\n    \"\"\"Format integer cents as '$1,234.56'. Negative values look like '-$0.05'.\"\"\"\n    sign = \"-\" if cents < 0 else \"\"\n    cents = abs(cents)\n    return f\"{sign}${cents // 100:,}.{cents % 100:02d}\"","lineStart":1,"lineEnd":22,"totalLines":22,"truncated":false}},"title":"private/tmp/claude-501/-Users-kalepail-Desktop-kalepail-skills/fd5aae97-76bc-4bb3-8597-af0fa91bb3f0/scratchpad/probe-runs/muse-xhigh__bugfix__r1__1791296736/work/ledger/money.py","time":{"start":1791296958691,"end":1791296958695}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_1119e70e0001UnO2YI4db6Il64","sessionID":"ses_eee64f141ffeh7TbaSa9O6N5ia","messageID":"msg_1119e0c63001Od7VcBVWAbXdxD"}}
