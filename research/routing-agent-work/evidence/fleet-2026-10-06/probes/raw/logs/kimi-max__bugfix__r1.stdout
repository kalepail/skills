{"type":"text","timestamp":1791297039052,"sessionID":"ses_eee62f560ffe3fOuWTJCagfjGr","part":{"id":"prt_1119f6c68001vkPQvCdU4wPwYE","messageID":"msg_1119f3cdd001T6grfJNWOnxo4S","sessionID":"ses_eee62f560ffe3fOuWTJCagfjGr","type":"text","text":"That failure is in my own ad-hoc check — `\"12\"` is not the canonical formatted form (`\"$12.00\"` is). Let me correct the check.","time":{"start":1791297023080,"end":1791297039051}}}
{"type":"tool_use","timestamp":1791297039161,"sessionID":"ses_eee62f560ffe3fOuWTJCagfjGr","part":{"type":"tool","tool":"bash","callID":"bash_12_b8a87b0b","state":{"status":"completed","input":{"command":"python3 - <<'EOF'\nfrom ledger.money import format_cents, parse_amount\nfrom ledger.parse import parse_date, parse_ledger, parse_record\nfrom ledger.report import top_items, summary_line\n\n# format_cents docstring edge cases\nassert format_cents(-5) == \"-$0.05\"\nassert format_cents(0) == \"$0.00\"\nassert format_cents(5) == \"$0.05\"\nassert format_cents(-123456) == \"-$1,234.56\"\nassert format_cents(100000000) == \"$1,000,000.00\"\n\n# parse_amount docstring cases\nassert parse_amount(\"0.5\") == 50\nassert parse_amount(\"$0.05\") == 5\nassert parse_amount(\"-$0.05\") == -5\n# round-trip against canonical forms\nfor s, canonical in [(\"$1,234.56\", \"$1,234.56\"), (\"-$3.10\", \"-$3.10\"),\n                     (\"12\", \"$12.00\"), (\"0.5\", \"$0.50\")]:\n    assert format_cents(parse_amount(s)) == canonical, (s, format_cents(parse_amount(s)))\n\n# parse_date\nassert parse_date(\" 2026-01-31 \") == (2026, 1, 31)\n\n# top_items tie-break: equal totals -> item name ascending\nrecs = [\n    {\"date\": (2026,1,1), \"item\": \"banana\", \"qty\": 1, \"unit_cents\": 100},\n    {\"date\": (2026,1,1), \"item\": \"apple\", \"qty\": 1, \"unit_cents\": 100},\n    {\"date\": (2026,1,1), \"item\": \"cherry\", \"qty\": 1, \"unit_cents\": 50},\n]\nassert top_items(recs, 3) == [(\"apple\", 100), (\"banana\", 100), (\"cherry\", 50)]\nassert top_items(recs, 1) == [(\"apple\", 100)]\nassert top_items(recs, 0) == []\nassert top_items([], 3) == []\n\n# summary_line default n=3\nassert summary_line(recs) == \"apple=$1.00; banana=$1.00; cherry=$0.50\"\n\n# parse_ledger skips blanks/comments incl. indented comment\ntext = \"\\n  # comment\\n2026-10-01 | Widget | 2 | $1.00\\n\\n\"\nassert parse_ledger(text) == [{\"date\": (2026,10,1), \"item\": \"widget\", \"qty\": 2, \"unit_cents\": 100}]\n\n# negative qty totals (refunds)\nneg = [{\"date\": (2026,1,1), \"item\": \"widget\", \"qty\": -1, \"unit_cents\": 310}]\nassert summary_line(neg, 1) == \"widget=-$3.10\"\n\nprint(\"all edge-case checks passed\")\nEOF"},"output":"all edge-case checks passed\n","metadata":{"output":"all edge-case checks passed\n","exit":0,"truncated":false},"title":"python3 - <<'EOF'\nfrom ledger.money import format_cents, parse_amount\nfrom ledger.parse import parse_date, parse_ledger, parse_record\nfrom ledger.report import top_items, summary_line\n\n# format_cents docstring edge cases\nassert format_cents(-5) == \"-$0.05\"\nassert format_cents(0) == \"$0.00\"\nassert format_cents(5) == \"$0.05\"\nassert format_cents(-123456) == \"-$1,234.56\"\nassert format_cents(100000000) == \"$1,000,000.00\"\n\n# parse_amount docstring cases\nassert parse_amount(\"0.5\") == 50\nassert parse_amount(\"$0.05\") == 5\nassert parse_amount(\"-$0.05\") == -5\n# round-trip against canonical forms\nfor s, canonical in [(\"$1,234.56\", \"$1,234.56\"), (\"-$3.10\", \"-$3.10\"),\n                     (\"12\", \"$12.00\"), (\"0.5\", \"$0.50\")]:\n    assert format_cents(parse_amount(s)) == canonical, (s, format_cents(parse_amount(s)))\n\n# parse_date\nassert parse_date(\" 2026-01-31 \") == (2026, 1, 31)\n\n# top_items tie-break: equal totals -> item name ascending\nrecs = [\n    {\"date\": (2026,1,1), \"item\": \"banana\", \"qty\": 1, \"unit_cents\": 100},\n    {\"date\": (2026,1,1), \"item\": \"apple\", \"qty\": 1, \"unit_cents\": 100},\n    {\"date\": (2026,1,1), \"item\": \"cherry\", \"qty\": 1, \"unit_cents\": 50},\n]\nassert top_items(recs, 3) == [(\"apple\", 100), (\"banana\", 100), (\"cherry\", 50)]\nassert top_items(recs, 1) == [(\"apple\", 100)]\nassert top_items(recs, 0) == []\nassert top_items([], 3) == []\n\n# summary_line default n=3\nassert summary_line(recs) == \"apple=$1.00; banana=$1.00; cherry=$0.50\"\n\n# parse_ledger skips blanks/comments incl. indented comment\ntext = \"\\n  # comment\\n2026-10-01 | Widget | 2 | $1.00\\n\\n\"\nassert parse_ledger(text) == [{\"date\": (2026,10,1), \"item\": \"widget\", \"qty\": 2, \"unit_cents\": 100}]\n\n# negative qty totals (refunds)\nneg = [{\"date\": (2026,1,1), \"item\": \"widget\", \"qty\": -1, \"unit_cents\": 310}]\nassert summary_line(neg, 1) == \"widget=-$3.10\"\n\nprint(\"all edge-case checks passed\")\nEOF","time":{"start":1791297039007,"end":1791297039149}},"id":"prt_1119f730f001n0Ra4cKEcpFekp","sessionID":"ses_eee62f560ffe3fOuWTJCagfjGr","messageID":"msg_1119f3cdd001T6grfJNWOnxo4S"}}
