{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom ledger.money import format_cents, parse_amount\nfrom ledger.parse import parse_date, parse_record, parse_ledger\nfrom ledger.report import line_total, totals_by_item, top_items, summary_line\n\nfor cents in list(range(-10000, 10001)) + [-10**30 - 5, 10**30 + 5]:\n    magnitude = abs(cents)\n    whole, fraction = divmod(magnitude, 100)\n    expected = ('-' if cents < 0 else '') + f'\"'${whole:,}.{fraction:02d}'\"'\n    assert format_cents(cents) == expected, cents\n    assert parse_amount(format_cents(cents)) == cents, cents\nfor text, expected in [('0.5', 50), ('  -\"'$1,234.56  '\"', -123456), ('12', 1200), ('\"'$0.05'\"', 5)]:\n    assert parse_amount(text) == expected\nassert parse_date(' 2024-02-29 ') == (2024, 2, 29)\nassert parse_record(' 2026-12-01 | Mixed CASE | -2 | -\"'$0.05 '\"') == {\n    'date': (2026, 12, 1), 'item': 'mixed case', 'qty': -2, 'unit_cents': -5,\n}\nassert parse_ledger('\\\\n  # comment\\\\n\\\\t\\\\n') == []\nrecords = parse_ledger('''\n  # comment\n2026-01-02 | zebra | 2 | \"'$1.00\n2026-01-03 | apple | 1 | $2.00\n\n2026-01-04 | zebra | -1 | $0.50\n2026-01-05 | banana | 3 | $0.50\n2026-01-06 | refund | 1 | -$0.05\n2026-01-07 | zero | 0 | $99.00\n'\"''')\nassert line_total(records[0]) == 200\nassert totals_by_item(iter(records)) == {'zebra': 150, 'apple': 200, 'banana': 150, 'refund': -5, 'zero': 0}\nexpected = [('apple', 200), ('banana', 150), ('zebra', 150), ('zero', 0), ('refund', -5)]\nfor ordered_records in [records, list(reversed(records))]:\n    for n in [0, 1, 2, 3, 5, 10]:\n        assert top_items(iter(ordered_records), n) == expected[:n]\nassert summary_line(records, 10) == 'apple=\"'$2.00; banana=$1.50; zebra=$1.50; zero=$0.00; refund=-$0.05'\"'\nassert summary_line(records, 0) == ''\nassert top_items([], 3) == []\nassert summary_line([]) == ''\nprint('Additional checks passed: money round trips, parsing, totals, ranking, ties, and summaries.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
