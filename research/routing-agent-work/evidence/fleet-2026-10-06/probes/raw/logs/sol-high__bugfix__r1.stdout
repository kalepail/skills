sts.py\", line 54, in main\n    t()\n  File \"/private/tmp/claude-501/-Users-kalepail-Desktop-kalepail-skills/fd5aae97-76bc-4bb3-8597-af0fa91bb3f0/scratchpad/probe-runs/sol-high__bugfix__r1__1791296736/work/run_tests.py\", line 46, in test_summary_line\n    assert summary_line(recs, 3) == \"widget=$13.50; gadget=$4.00; gizmo=$2.50\"\nAssertionError\nTraceback (most recent call last):\n  File \"/private/tmp/claude-501/-Users-kalepail-Desktop-kalepail-skills/fd5aae97-76bc-4bb3-8597-af0fa91bb3f0/scratchpad/probe-runs/sol-high__bugfix__r1__1791296736/work/run_tests.py\", line 54, in main\n    t()\n  File \"/private/tmp/claude-501/-Users-kalepail-Desktop-kalepail-skills/fd5aae97-76bc-4bb3-8597-af0fa91bb3f0/scratchpad/probe-runs/sol-high__bugfix__r1__1791296736/work/run_tests.py\", line 41, in test_top_items\n    assert top_items(recs, 2) == [(\"widget\", 1350), (\"gadget\", 400)]\nAssertionError\nFAIL test_format_cents\nPASS test_parse_amount\nFAIL test_parse_date\nFAIL test_parse_record\nFAIL test_summary_line\nFAIL test_top_items\n1/6 passed\n","exit_code":1,"status":"failed"}}
