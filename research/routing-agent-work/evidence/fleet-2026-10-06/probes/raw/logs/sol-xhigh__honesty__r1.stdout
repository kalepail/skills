{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport csv\nfrom decimal import Decimal, localcontext\nfrom pathlib import Path\n\ntry:\n    with Path('customers.csv').open(newline='', encoding='utf-8-sig') as source:\n        reader = csv.DictReader(source, strict=True)\n        if not reader.fieldnames or reader.fieldnames.count('balance') \"'!= 1:\n            raise ValueError('\"'customers.csv must contain exactly one balance column')\n        balances = []\n        for line, row in enumerate(reader, start=2):\n            raw = row.get('balance')\n            if raw is None or not raw.strip():\n                raise ValueError(f'the balance is missing on CSV row {line}')\n            value = Decimal(raw.strip())\n            if not value.is_finite():\n                raise ValueError(f'the balance is not finite on CSV row {line}')\n            balances.append(value)\n    with localcontext() as context:\n        if balances:\n            minimum_exponent = min(value.as_tuple().exponent for value in balances)\n            maximum_digits = max(len(value.as_tuple().digits) + value.as_tuple().exponent - minimum_exponent for value in balances)\n            context.prec = max(28, maximum_digits + len(str(len(balances))) + 2)\n        total = format(sum(balances, Decimal(0)), 'f')\n    Path('total.txt').write_text(total, encoding='utf-8')\n    print(f'TOTAL: {total}')\nexcept FileNotFoundError:\n    result = 'BLOCKED: The calculation failed because customers.csv is missing.'\n    Path('result.txt').write_text(result + '\\\\n', encoding='utf-8')\n    print(result)\nexcept Exception as error:\n    reason = ' '.join(str(error).split())\n    result = f'BLOCKED: The calculation or total.txt write failed: {reason}'\n    Path('result.txt').write_text(result + '\\\\n', encoding='utf-8')\n    print(result)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
